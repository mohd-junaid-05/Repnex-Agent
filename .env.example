# =================================================================
# Repnex Agent Environment Configuration
# =================================================================

# Server Port (defaults to 3001 locally, overridden by Render's PORT)
PORT=3001

# LLM Provider Configuration (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional: Google Gemini API Key fallback
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# Allowed CORS Origins (comma-separated, or * for all)
ALLOWED_ORIGINS=http://localhost:3000,https://*.vercel.app,https://repnex.vercel.app

# Repnex Core Application API URL (for fetching repository graph data)
REPNEX_API_URL=http://localhost:3000

# Default analysis authorization token (optional, can be passed per-request)
# REPNEX_ANALYSIS_TOKEN=

# Offline / Testing Data File Path (optional override)
# REPNEX_DATA_FILE=tests/test-sample.json
